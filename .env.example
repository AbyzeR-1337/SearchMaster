# All keys are OPTIONAL. Without them SearchMaster still searches ~15 free sources.
# Locally: copy to .env and `set -a; source .env; set +a` (or set them in your shell).
# In GitHub: Settings → Secrets and variables → Actions → New repository secret (same names).

# Web search across the whole internet (any one is enough):
BRAVE_API_KEY=          # https://api-dashboard.search.brave.com/ (free plan)
GOOGLE_API_KEY=         # https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_ID=          # https://programmablesearchengine.google.com/ ("Search the entire web")
SEARXNG_URL=            # your own SearXNG instance with JSON output enabled

# Extra sources:
YOUTUBE_API_KEY=        # Google Cloud console → YouTube Data API v3
RAWG_API_KEY=           # https://rawg.io/apidocs
REDDIT_CLIENT_ID=       # https://www.reddit.com/prefs/apps (type "script")
REDDIT_CLIENT_SECRET=
GH_SEARCH_TOKEN=        # GitHub personal token (read-only) — enables code search across GitHub
STACKEXCHANGE_KEY=      # raises the daily Stack Exchange quota

# AI analysis of what was found (summary, facts, timeline, where to look next):
ANTHROPIC_API_KEY=      # https://console.anthropic.com/
